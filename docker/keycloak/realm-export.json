{
  "realm": "card-billing",
  "enabled": true,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "reconciliation-service",
      "name": "reconciliation-service",
      "description": "External statement ingest and matching. Client-credentials only - it calls billing-service, and no user is ever behind a reconciliation run.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "local-development-secret"
    },
    {
      "clientId": "billing-service",
      "name": "billing-service",
      "description": "Owns invoices and payments. Present here so a token issued by this realm is accepted by it locally.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "local-development-secret"
    }
  ]
}
